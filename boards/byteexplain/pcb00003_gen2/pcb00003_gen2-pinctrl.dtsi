 *
 * PLACEHOLDER pinmux — replace after Altium netlist / REV11 continuity.
 * Nets: SDA, SCL, INT_ACC, INT_OPT, SENS_EN, CHRSTS, BATEN, BATVOL
 * See cursor_oralable/docs/PCB00003_GEN2_REV11_HARDWARE.md §5
 */

&pinctrl {
	i2c20_default: i2c20_default {
		group1 {
			/* TBD: map SDA / SCL to ES4L15BA1 module pins */
			psels = <NRF_PSEL(TWIM_SDA, 0, 3)>,
				<NRF_PSEL(TWIM_SCL, 2, 2)>;
		};
	};

	i2c20_sleep: i2c20_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 3)>,
				<NRF_PSEL(TWIM_SCL, 2, 2)>;
			low-power-enable;
		};
	};
};

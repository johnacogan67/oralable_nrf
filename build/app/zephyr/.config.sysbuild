# sysbuild controlled configuration settings
CONFIG_PARTITION_MANAGER_ENABLED=y
CONFIG_BUILD_OUTPUT_BIN=y
CONFIG_BUILD_OUTPUT_HEX=y
CONFIG_PM_EXTERNAL_FLASH_MCUBOOT_SECONDARY=n
CONFIG_UPDATEABLE_IMAGE_NUMBER=1
CONFIG_MCUBOOT_BOOTLOADER_MODE_SINGLE_APP=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_SWAP_WITHOUT_SCRATCH=y
CONFIG_MCUBOOT_BOOTLOADER_MODE_SWAP_SCRATCH=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_OVERWRITE_ONLY=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_DIRECT_XIP=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_DIRECT_XIP_WITH_REVERT=n
CONFIG_MCUBOOT_BOOTLOADER_MODE_FIRMWARE_UPDATER=n
CONFIG_MCUBOOT_HARDWARE_DOWNGRADE_PREVENTION=n
CONFIG_BT_FAST_PAIR=n
CONFIG_WIFI_NRF700X=n
CONFIG_CHIP=n
CONFIG_ROM_END_OFFSET=0x2000
CONFIG_MCUBOOT_UPDATE_FOOTER_SIZE=0x2000
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_MCUBOOT_SIGNATURE_KEY_FILE="/Users/johnacogan67/tgm_firmware/bootloader/mcuboot/root-rsa-2048.pem"
CONFIG_MCUBOOT_ENCRYPTION_KEY_FILE=""
CONFIG_MCUBOOT_GENERATE_UNSIGNED_IMAGE=n
